        <elementProp name="ThreadGroup.main_controller" elementType="com.blazemeter.jmeter.control.VirtualUserController"/>
        <stringProp name="TestPlan.comments">Optional stepped load (stress/capacity). Needs plugin jpgc-casutg (installed in the Docker image). Enable in the GUI.</stringProp>
