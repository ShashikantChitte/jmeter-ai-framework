      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="TG-10 Load generator health probe">
        <stringProp name="TestPlan.comments">Writes results/lg_health.csv (CPU, heap, GC, threads, FDs, network). Keep generator CPU &lt; 70-80%.</stringProp>
        <stringProp name="ThreadGroup.num_threads">${__P(lg_health,1)}</stringProp>
        <intProp name="ThreadGroup.ramp_time">1</intProp>
        <stringProp name="ThreadGroup.duration">${__P(duration,300)}</stringProp>
        <longProp name="ThreadGroup.delay">0</longProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <intProp name="LoopController.loops">-1</intProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="LG_Health_Probe">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">// Load-generator self-monitoring: CPU, heap, GC, threads, file descriptors, network
import java.lang.management.ManagementFactory
try { SampleResult.setIgnore() } catch (Throwable t) { }
def os = ManagementFactory.getOperatingSystemMXBean()
def mem = ManagementFactory.getMemoryMXBean()
def heap = mem.getHeapMemoryUsage()
def nonHeap = mem.getNonHeapMemoryUsage()
long gcCount = 0L
long gcTime = 0L
ManagementFactory.getGarbageCollectorMXBeans().each { b -&gt;
    gcCount += Math.max(b.getCollectionCount(), 0L)
    gcTime += Math.max(b.getCollectionTime(), 0L)
}
double procCpu = -1d
double sysCpu = -1d
long fds = -1L
if (os instanceof com.sun.management.OperatingSystemMXBean) { procCpu = os.getProcessCpuLoad(); sysCpu = os.getCpuLoad() }
if (os instanceof com.sun.management.UnixOperatingSystemMXBean) { fds = os.getOpenFileDescriptorCount() }
long rx = 0L
long tx = 0L
def netFile = new File(&quot;/proc/net/dev&quot;)
if (netFile.exists()) {
    netFile.eachLine { line -&gt;
        if (line.contains(&quot;:&quot;) &amp;&amp; !line.trim().startsWith(&quot;lo:&quot;)) {
            def p = line.split(&quot;:&quot;)[1].trim().split(&quot;\\s+&quot;)
            rx += p[0].toLong()
            tx += p[8].toLong()
        }
    }
}
long now = System.currentTimeMillis()
def last = props.get(&quot;lg.prev&quot;)
double rxMBs = 0d
double txMBs = 0d
if (last != null) {
    double dt = (now - last[0]) / 1000.0d
    if (dt &gt; 0) { rxMBs = (rx - last[1]) / dt / 1048576.0d; txMBs = (tx - last[2]) / dt / 1048576.0d }
}
props.put(&quot;lg.prev&quot;, [now, rx, tx])
def dir = new File(props.getProperty(&quot;results_dir&quot;) ?: &quot;results&quot;)
dir.mkdirs()
def f = new File(dir, &quot;lg_health.csv&quot;)
if (!f.exists()) {
    f &lt;&lt; &quot;timestamp,host,proc_cpu,sys_cpu,heap_used_mb,heap_max_mb,nonheap_used_mb,gc_count,gc_time_ms,open_fds,threads,rx_mb_s,tx_mb_s\n&quot;
}
def host = InetAddress.getLocalHost().getHostName()
def row = [now, host, String.format(&quot;%.3f&quot;, procCpu), String.format(&quot;%.3f&quot;, sysCpu),
           (long) (heap.getUsed() / 1048576), (long) (heap.getMax() / 1048576), (long) (nonHeap.getUsed() / 1048576),
           gcCount, gcTime, fds, ManagementFactory.getThreadMXBean().getThreadCount(),
           String.format(&quot;%.3f&quot;, rxMBs), String.format(&quot;%.3f&quot;, txMBs)]
f &lt;&lt; row.join(&quot;,&quot;) + &quot;\n&quot;
double warn = Double.parseDouble(props.getProperty(&quot;lg_cpu_warn&quot;) ?: &quot;0.80&quot;)
if (sysCpu &gt; warn) {
    log.warn(&quot;LOAD GENERATOR CPU HIGH: &quot; + String.format(&quot;%.0f&quot;, sysCpu * 100) + &quot;% on &quot; + host + &quot; - results may be distorted. Add generators.&quot;)
}
SampleResult.setResponseData(row.join(&quot;,&quot;), &quot;UTF-8&quot;)
SampleResult.setSuccessful(true)</stringProp>
        </JSR223Sampler>
        <hashTree/>
        <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="Probe interval">
          <stringProp name="ConstantTimer.delay">${__P(lg_health_interval_ms,5000)}</stringProp>
        </ConstantTimer>
