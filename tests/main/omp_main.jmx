      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="TEARDOWN_Close_Clients">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">// Close shared clients and write run metadata
def kp = props.get(&quot;omp.kafka.producer&quot;)
if (kp != null) { try { kp.close() } catch (Throwable t) { log.warn(&quot;kafka close: &quot; + t) } }
def dir = new File(props.getProperty(&quot;results_dir&quot;) ?: &quot;results&quot;)
dir.mkdirs()
new File(dir, &quot;run_info.json&quot;).text = &apos;{&quot;testrun&quot;:&quot;&apos; + (props.getProperty(&quot;testrun&quot;) ?: &quot;local&quot;) +
    &apos;&quot;,&quot;env&quot;:&quot;&apos; + (props.getProperty(&quot;env&quot;) ?: &quot;local&quot;) + &apos;&quot;,&quot;users&quot;:&quot;&apos; + (props.getProperty(&quot;users&quot;) ?: &quot;&quot;) +
    &apos;&quot;,&quot;workers&quot;:&quot;&apos; + (props.getProperty(&quot;workers&quot;) ?: &quot;1&quot;) + &apos;&quot;,&quot;finished&quot;:&apos; + System.currentTimeMillis() + &apos;}&apos;
SampleResult.setResponseData(&quot;teardown complete&quot;, &quot;UTF-8&quot;)
SampleResult.setSuccessful(true)</stringProp>
        </JSR223Sampler>
