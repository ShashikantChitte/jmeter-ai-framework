<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="OMP Performance Framework - Master Plan">
      <stringProp name="TestPlan.comments">Scalable JMeter framework: modular (Include/Module Controllers + Test Fragments), property-driven (__P), multi-protocol, OAuth2/JWT, Backend Listener, distributed-ready. See README.md.</stringProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
    </TestPlan>
    <hashTree>
      <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="Global variables (all from properties)">
        <collectionProp name="Arguments.arguments">
          <elementProp name="env" elementType="Argument">
            <stringProp name="Argument.name">env</stringProp>
            <stringProp name="Argument.value">${__P(env,local)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="AUTH_MODE" elementType="Argument">
            <stringProp name="Argument.name">AUTH_MODE</stringProp>
            <stringProp name="Argument.value">${__P(auth_mode,jwt)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="authHeader" elementType="Argument">
            <stringProp name="Argument.name">authHeader</stringProp>
            <stringProp name="Argument.value">Bearer anonymous</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </Arguments>
      <hashTree/>
