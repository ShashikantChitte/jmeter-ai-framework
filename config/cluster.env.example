# Copy to config/cluster.env and edit.  (cluster.env is git-ignored: it describes YOUR machines)
MASTER_IP=10.0.0.10                    # this machine (controller / "master") - must be reachable BY the workers
WORKERS="10.0.0.11 10.0.0.12 10.0.0.13"  # worker / "slave" machines (space separated)
SSH_USER=perf                          # user with SSH key access + sudo (for bootstrap only) on every worker
SSH_KEY=~/.ssh/id_rsa
REMOTE_DIR=/opt/omp                    # framework location. MUST be the SAME absolute path on master and workers
JMETER_VERSION=5.6.3
WORKER_HEAP="-Xms4g -Xmx4g -XX:MaxMetaspaceSize=256m"   # keep below the worker's RAM (leave room for OS/off-heap)
