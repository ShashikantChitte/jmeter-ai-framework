    }
   }
  }
 ],
 "annotations": {
  "list": [
   {
    "name": "Test events",
    "datasource": {
     "type": "influxdb",
     "uid": "influxdb-jmeter"
    },
    "enable": true,
    "iconColor": "#5794F2",
    "query": "SELECT \"text\",\"title\" FROM \"events\" WHERE $timeFilter",
    "titleColumn": "title",
    "textColumn": "text",
    "type": "tags"
   }
  ]
 }
}