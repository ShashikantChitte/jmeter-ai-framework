    }
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Network: bytes received / sent per interval",
   "description": "",
   "datasource": {
    "type": "influxdb",
    "uid": "influxdb-jmeter"
   },
   "gridPos": {
    "x": 12,
    "y": 15,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "influxdb",
      "uid": "influxdb-jmeter"
     },
     "rawQuery": true,
     "resultFormat": "time_series",
     "query": "SELECT sum(\"rb\") FROM \"jmeter\" WHERE \"application\" =~ /^$application$/ AND \"transaction\" =~ /^$transaction$/ AND $timeFilter AND \"statut\"='all' GROUP BY time($__interval) fill(0)",
     "alias": "received"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "influxdb",
      "uid": "influxdb-jmeter"
     },
     "rawQuery": true,
     "resultFormat": "time_series",
     "query": "SELECT sum(\"sb\") FROM \"jmeter\" WHERE \"application\" =~ /^$application$/ AND \"transaction\" =~ /^$transaction$/ AND $timeFilter AND \"statut\"='all' GROUP BY time($__interval) fill(0)",
