  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Average / max response time (ms)",
   "description": "",
   "datasource": {
    "type": "influxdb",
    "uid": "influxdb-jmeter"
   },
   "gridPos": {
    "x": 0,
    "y": 15,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "influxdb",
      "uid": "influxdb-jmeter"
     },
     "rawQuery": true,
     "resultFormat": "time_series",
     "query": "SELECT mean(\"avg\") FROM \"jmeter\" WHERE \"application\" =~ /^$application$/ AND \"transaction\" =~ /^$transaction$/ AND $timeFilter AND \"statut\"='ok' GROUP BY time($__interval), \"transaction\" fill(null)",
     "alias": "avg $tag_transaction"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "influxdb",
      "uid": "influxdb-jmeter"
     },
     "rawQuery": true,
     "resultFormat": "time_series",
     "query": "SELECT max(\"max\") FROM \"jmeter\" WHERE \"application\" =~ /^$application$/ AND \"transaction\" =~ /^$transaction$/ AND $timeFilter AND \"statut\"='ok' GROUP BY time($__interval), \"transaction\" fill(null)",
     "alias": "max $tag_transaction"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 8
     },
     "unit": "ms"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "mean",
      "max",
      "last"
     ]
    },
    "tooltip": {
